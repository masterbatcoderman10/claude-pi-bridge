{
  "name": "claude-pi-bridge",
  "version": "0.1.2",
  "description": "MCP server that lets Claude Code spawn and manage headless Pi coding agents",
  "type": "module",
  "bin": {
    "claude-pi-bridge": "dist/mcp-server.js",
    "claude-pi-bridge-http": "dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev:mcp": "tsx src/mcp-server.ts",
    "dev:http": "tsx src/http-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
